{
  "rewrites": [
    {
      "source": "/api/maoyan",
      "has": [
        { "type": "query", "key": "action", "value": "videos" }
      ],
      "destination": "/api/trailers"
    },
    { "source": "/", "destination": "/data-lab/realtime.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=120, stale-while-revalidate=600" }
      ]
    }
  ]
}
